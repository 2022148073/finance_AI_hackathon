# Copy this file to backend/.env. Never commit the real .env file.
# Development may use the plain environment secret below. For production,
# remove it and set FLOWBIT_ACCESS_CODE_HASH to `python -m access_gate` output.
FLOWBIT_ENV=development
FLOWBIT_ACCESS_CODE=replace_with_your_invitation_code
# FLOWBIT_ACCESS_CODE_HASH=pbkdf2_sha256$600000$...
FLOWBIT_ACCESS_SESSION_TTL_SECONDS=28800
FLOWBIT_ACCESS_RATE_LIMIT_ATTEMPTS=5
FLOWBIT_ACCESS_RATE_LIMIT_WINDOW_SECONDS=300
FLOWBIT_COOKIE_SAMESITE=lax
# FLOWBIT_COOKIE_SECURE=true

NVIDIA_API_KEY=replace_with_your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=openai/gpt-oss-20b

# GPT-OSS 20B supports low, medium, and high reasoning effort.
NVIDIA_LLM_REASONING_EFFORT=low
# Bump this revision when prompt/runtime semantics change without a schema change.
# It is part of the stored analysis cache key.
NVIDIA_LLM_ANALYSIS_REVISION=gpt_oss_20b_v1
NVIDIA_LLM_TEMPERATURE=0.2
NVIDIA_LLM_MAX_TOKENS=4096
NVIDIA_LLM_TIMEOUT_SECONDS=180
NVIDIA_LLM_STATUS_POLL_INTERVAL_SECONDS=2
