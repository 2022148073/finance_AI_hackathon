# Copy this file to backend/.env. Never commit the real .env file.
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
KIMI_MODEL=moonshotai/kimi-k3

# Kimi-K3 thinking is always enabled. Development default: low.
# Allowed values: low, high, max
KIMI_REASONING_EFFORT=low
KIMI_TEMPERATURE=1.0
KIMI_MAX_TOKENS=16384
KIMI_TIMEOUT_SECONDS=120
KIMI_MAX_RETRIES=1
